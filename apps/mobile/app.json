{
  "expo": {
    "name": "lnwjud Companion",
    "slug": "lnwjud-companion",
    "version": "4.61.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "lnwjud-companion",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow lnwjud Companion to scan a pairing QR code from lnwjud Desktop."
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow lnwjud Companion to protect trusted-device credentials."
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.saisansan11.lnwjud.companion"
    },
    "android": {
      "package": "com.saisansan11.lnwjud.companion",
      "adaptiveIcon": {
        "backgroundColor": "#070A10",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    }
  }
}
